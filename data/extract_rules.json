    "opaque_canary": {
      "reason": "The four creatures whose frame 5 is an anchor speck rather than a body, which the README states as a small bounding box and which is really a pixel count: wolf declares 4x11 but ghost declares 60x109 and is 91 percent of its frame 1 by area. Measured coverage is 2, 15, 30 and 63 opaque pixels against 1054 for the nearest non-member, so the threshold is not delicate. It is a canary for a decoder that has gone wrong in a way no size or count check would catch.",
      "frame": 5,
      "max_opaque": 100,
      "dirs": ["wolf.std", "gargoyle.std", "griffin.std", "ghost.std"]
    },
    "expected_duplicates": {
      "reason": "Frames the archive stores more than once. Declared so the checker treats them as the archive's shape rather than a decoder fault. About 135 files, all named in data/creatures/anim_table.json.",
